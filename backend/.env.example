# ============================================================================
# AceMock backend env. Copy to .env and fill in. Everything degrades gracefully:
# with no keys the app still runs (offline LLM stub, browser voice fallback,
# dev anonymous user, billing disabled).
# ============================================================================

# --- Database (Supabase or local Postgres with pgvector; asyncpg driver) ---
DATABASE_URL=postgresql+asyncpg://acemock:acemock@localhost:5432/acemock

# --- LLM (cheapest first). Pick ONE provider and set its key. ---
# Options: deepseek (cheapest major) | gemini (Flash-Lite, cheapest) | groq | openai | together | anthropic
LLM_PROVIDER=deepseek
LLM_API_KEY=
# Optional overrides; leave blank to use the provider preset model/base_url.
LLM_BASE_URL=
LLM_MODEL=
# Only if LLM_PROVIDER=anthropic:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4.5

# --- Embeddings (OpenAI-compatible). For a free tier, point base_url at Gemini. ---
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- Voice: ElevenLabs Flash TTS (cheapest) + optional Groq Whisper STT ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_flash_v2_5
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo

# --- Auth (Clerk). Unset = dev mode (anonymous user). ---
CLERK_SECRET_KEY=
# Found in Clerk dashboard: API keys / JWT. Example issuer: https://your-app.clerk.accounts.dev
CLERK_ISSUER=
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json

# --- Billing (Stripe). Unset = billing disabled. ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_QUANT=
BILLING_SUCCESS_URL=http://localhost:3000/?upgraded=1
BILLING_CANCEL_URL=http://localhost:3000/pricing

# --- Free tier ---
FREE_MONTHLY_MOCKS=3

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:3000
